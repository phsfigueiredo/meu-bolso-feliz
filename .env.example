# --- Backend online (Supabase) ---
# Deixe VAZIO para desabilitar Supabase (usa IndexedDB local)
# Preenchido → o app fala com Postgres via SDK oficial + RLS
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend Express local (dev) ---
VITE_API_URL=http://localhost:3001
PORT=3001

# --- Storage mode override ---
# Opcional. Valores válidos: supabase | api | local
# Se não setado, detecta automaticamente: supabase > api > local
# VITE_STORAGE=local
